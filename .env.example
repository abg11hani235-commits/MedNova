# Clinsight Environment Variables Template
# Copy to .env and provide local values. NEVER commit secrets or real keys.

# Database (PostgreSQL + pgvector on host port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/clinsight

# LLM Configuration (Groq OpenAI-compatible)
GROQ_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_REQUESTS_PER_MINUTE=30

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Storage
STORAGE_PATH=./data/storage
