# Clinsight Environment Variables Template
# Copy to .env and provide local values. NEVER commit secrets or real keys.

# Database (PostgreSQL + pgvector on host port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/clinsight

# LLM Configuration (OpenRouter / OpenAI-compatible)
LLM_API_KEY=
GROQ_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_STRUCTURED_OUTPUT=false
LLM_HTTP_REFERER=
LLM_TITLE=
LLM_REQUESTS_PER_MINUTE=10

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Storage
STORAGE_PATH=./data/storage
